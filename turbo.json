{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "globalPassThroughEnv": ["PATH"],
    // Self-hosted remote cache (apps/otta-cache). apiUrl/team/token come from TURBO_API / TURBO_TEAM / TURBO_TOKEN
    // env vars (CI secrets or a developer's shell), never from this file, so forks work untouched.
    // signature: artifacts are HMAC-signed with TURBO_REMOTE_CACHE_SIGNATURE_KEY; production rejects unsigned uploads.
    "remoteCache": { "signature": true },
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        // The root eslint.config.mjs is the one config for every workspace: a rule change must bust the cache.
        "lint": {
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
        },
        "type-check": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"]
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "vitest.setup.*"],
            "outputs": [],
            "env": ["NODE_ENV=test"]
        },
        // lint-invariants.test.ts runs the root eslint.config.mjs: a rule change must re-run it.
        "@ottabase/scripts#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "vitest.config.*", "vitest.setup.*", "$TURBO_ROOT$/eslint.config.mjs"],
            "outputs": [],
            "env": ["NODE_ENV=test"]
        },
        "clean": {
            "cache": false
        }
    },
    "globalDependencies": ["package.json", "pnpm-lock.yaml", "turbo.json", "tsconfig.json"]
}
